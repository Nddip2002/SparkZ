# ---- Server ----
PORT=3000
NODE_ENV=development
# Comma-separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:5173

# ---- Database (Supabase PostgreSQL) ----
# Runtime: transaction-mode connection pooler (port 6543)
DATABASE_URL=postgresql://postgres.your-project-ref:your-password@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true
# Prisma CLI / migrations: direct or session-mode connection (port 5432)
DIRECT_URL=postgresql://postgres.your-project-ref:your-password@aws-0-region.pooler.supabase.com:5432/postgres

# ---- Supabase Auth ----
# Used to build the JWKS URL (<SUPABASE_URL>/auth/v1/.well-known/jwks.json) for asymmetric JWT signing keys
SUPABASE_URL=https://your-project-ref.supabase.co
# Optional: legacy HS256 JWT secret (Project Settings -> API -> JWT Secret). Leave blank to use JWKS only.
SUPABASE_JWT_SECRET=

# ---- Commerce ----
SHIPPING_FLAT_RATE=99
FREE_SHIPPING_THRESHOLD=999
