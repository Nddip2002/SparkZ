// SparkZ — 5-table relational + JSONB hybrid schema.
// Runtime connections go through @prisma/adapter-pg (DATABASE_URL, pooler).
// Prisma CLI / migrations use DIRECT_URL (see prisma.config.ts).

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
  runtime      = "nodejs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CUSTOMER
  ADMIN
}

enum AccountType {
  INDIVIDUAL
  BUSINESS
}

enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

/// Mirrors Supabase auth.users — `id` equals the JWT `sub` claim.
model User {
  id          String      @id @db.Uuid
  email       String      @unique
  fullName    String?     @map("full_name")
  phone       String?
  role        Role        @default(CUSTOMER)
  accountType AccountType @default(INDIVIDUAL) @map("account_type")
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  cartItems CartItem[]
  orders    Order[]

  @@map("users")
}

model Product {
  id             String   @id @default(uuid()) @db.Uuid
  sku            String   @unique
  mpn            String
  category       String
  subcategory    String?
  manufacturer   String
  name           String
  slug           String   @unique
  description    String
  unitPrice      Decimal  @map("unit_price") @db.Decimal(12, 2)
  stockQuantity  Int      @default(0) @map("stock_quantity")
  imageUrls      String[] @default([]) @map("image_urls")
  datasheetUrl   String?  @map("datasheet_url")
  /// Free-form technical attributes (e.g. { "voltage": "3.3V", "package": "QFN-56" }).
  specifications Json     @default("{}")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  cartItems  CartItem[]
  orderItems OrderItem[]

  @@index([specifications(ops: JsonbPathOps)], type: Gin)
  @@index([category, subcategory])
  @@index([manufacturer])
  @@index([isActive, createdAt])
  @@map("products")
}

model CartItem {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  productId String   @map("product_id") @db.Uuid
  quantity  Int
  addedAt   DateTime @default(now()) @map("added_at") @db.Timestamptz(6)

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@map("cart_items")
}

model Order {
  id               String        @id @default(uuid()) @db.Uuid
  /// Format: SZ-YYYY-NNNN
  orderNumber      String        @unique @map("order_number")
  userId           String        @map("user_id") @db.Uuid
  /// Immutable snapshot of the address at checkout time.
  shippingAddress  Json          @map("shipping_address")
  subtotal         Decimal       @db.Decimal(12, 2)
  shippingCost     Decimal       @map("shipping_cost") @db.Decimal(12, 2)
  totalAmount      Decimal       @map("total_amount") @db.Decimal(12, 2)
  status           OrderStatus   @default(PENDING)
  paymentStatus    PaymentStatus @default(PENDING) @map("payment_status")
  paymentReference String?       @map("payment_reference")
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  user  User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  items OrderItem[]

  @@index([userId, createdAt])
  @@map("orders")
}

model OrderItem {
  id                  String  @id @default(uuid()) @db.Uuid
  orderId             String  @map("order_id") @db.Uuid
  productId           String  @map("product_id") @db.Uuid
  quantity            Int
  unitPriceAtPurchase Decimal @map("unit_price_at_purchase") @db.Decimal(12, 2)

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@map("order_items")
}
